# Product section (Roadmap & Priorities, Challenges) — Supabase.
# Copy to .env.local and fill in. See README "Product section — Supabase setup".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the seed/admin scripts, never shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Postgres connection string (Project Settings → Database → Connection string → URI), used by `npm run db:seed`.
SUPABASE_DB_URL=
